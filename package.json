{
  "name": "cartmind",
  "version": "1.0.0",
  "description": "AI grocery basket intelligence: next-in-cart prediction, reorder clock, bundle simulation and GenAI campaigns.",
  "scripts": {
    "build:html": "node tools/build.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/app.css -o assets/css/app.css --minify",
    "build": "npm run build:html && npm run build:css",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/styles/app.css -o assets/css/app.css --watch",
    "serve": "npx --yes serve -l 5173 .",
    "dev": "npm run build && npm run serve"
  },
  "keywords": [
    "market-basket-analysis",
    "recommendation-engine",
    "retail-analytics",
    "instacart",
    "dashboard",
    "animation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "private": true
}